# Copy this file to .streamlit/secrets.toml and fill in the values.
# Never commit .streamlit/secrets.toml (it is listed in .gitignore).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "PASTE_A_LONG_RANDOM_STRING"

[auth.ssojet]
client_id = "PASTE_FROM_SSOJET"
client_secret = "PASTE_FROM_SSOJET"
# The OpenID configuration (discovery) URL from SSOJet; it ends in /.well-known/openid-configuration
server_metadata_url = "PASTE_FROM_SSOJET"

[tigerdata]
# The connection string from your Tiger Data service, e.g.
# postgres://tsdbadmin:PASSWORD@abc123.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
url = "PASTE_FROM_TIGER_DATA"
